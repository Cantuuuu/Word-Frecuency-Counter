FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias primero para aprovechar la caché de capas de Docker.
# Si solo cambia el código fuente, esta capa no se reconstruye.
COPY requierements.txt .
RUN pip install --no-cache-dir -r requierements.txt

# Copiar solo los archivos necesarios para el Ambassador
COPY ambassador.py config.py circuit_breaker_mock.py ./

EXPOSE 5005

# Flask corre directamente desde ambassador.py (app.run con threaded=True)
CMD ["python", "ambassador.py"]
