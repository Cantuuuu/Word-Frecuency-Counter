# .env.example — Plantilla de variables de entorno para el Ambassador.
#
# INSTRUCCIONES:
#   1. Copiar este archivo:  cp .env.example .env
#   2. En cada laptop worker, obtener su IP:
#        - Windows:  ipconfig  → buscar "IPv4" del adaptador Wi-Fi
#        - macOS:    ifconfig en0  → buscar "inet"
#   3. Reemplazar las IPs de ejemplo con las IPs reales.
#   4. Ejecutar:  docker-compose up --build
#
# MODO LOCAL (pruebas en una sola máquina):
#   Dejar las 3 URLs apuntando a worker_local:5001 (el contenedor local
#   definido en docker-compose.yml).
#
# MODO RED (demo con múltiples laptops):
#   Cada URL debe apuntar a la IP real de la laptop que corre ese worker.
#   El puerto siempre es 5001 (expuesto por Docker en cada laptop remota).

# --- Modo local (una sola máquina) ---
# WORKER_1_URL=http://worker_local:5001
# WORKER_2_URL=http://worker_local:5001
# WORKER_3_URL=http://worker_local:5001

# --- Modo red (múltiples laptops) ---
# Ejemplo: laptop 1 tiene IP 192.168.1.101, laptop 2 tiene 192.168.1.102, etc.
WORKER_1_URL=http://192.168.1.101:5001
WORKER_2_URL=http://192.168.1.102:5001
WORKER_3_URL=http://192.168.1.103:5001
