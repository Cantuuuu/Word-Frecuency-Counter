# .env.example — Plantilla de variables de entorno para el Ambassador.
#
# INSTRUCCIONES PARA EL DÍA DE LA DEMO:
#   1. Copiar este archivo: cp .env.example .env
#   2. Reemplazar las IPs con las IPs reales de cada laptop en la red WiFi del salón.
#   3. Ejecutar: docker-compose up
#
# Las IPs actuales son de ejemplo; la red real del salón asignará IPs distintas.

WORKER_1_URL=http://192.168.1.101:5001
WORKER_2_URL=http://192.168.1.102:5001
WORKER_3_URL=http://192.168.1.103:5001
